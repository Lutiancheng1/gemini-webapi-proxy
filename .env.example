# ── Server ───────────────────────────────────────────
GOP_PORT=4982
GOP_HOST=0.0.0.0
# GOP_API_KEY=set-me-to-enable-bearer-auth
GOP_LOG_FORMAT=console        # console (dev) or json (container)
GOP_LOG_LEVEL=INFO

# ── Cookie source ───────────────────────────────────
# browser  — read from a desktop browser (macOS Safari / Linux Chrome)
# env      — read GOP_GEMINI_1PSID / GOP_GEMINI_1PSIDTS from env
# file     — read a Netscape-format cookies.txt
GOP_COOKIE_SOURCE=browser
GOP_BROWSER=auto              # auto / safari / chrome / edge / brave / chromium
# GOP_COOKIE_FILE=/etc/gemini/cookies.txt
# GOP_GEMINI_1PSID=...
# GOP_GEMINI_1PSIDTS=...

# ── Network ─────────────────────────────────────────
# Local HTTP proxy (Clash / mitmproxy / etc.) — used by both the API and
# non-CDN image downloads. Google CDN domains are bypassed automatically.
GOP_HTTP_PROXY=http://127.0.0.1:7897
GOP_CDN_DIRECT=true

# ── Behaviour ───────────────────────────────────────
GOP_CHAT_TIMEOUT=180
GOP_IMAGE_TIMEOUT=300
GOP_INIT_TIMEOUT=120
GOP_PROBE_ON_START=false

# ── Data ────────────────────────────────────────────
GOP_DATA_DIR=./data
